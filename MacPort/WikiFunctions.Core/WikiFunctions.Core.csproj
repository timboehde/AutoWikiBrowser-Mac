<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mac port of the WikiFunctions engine. Source files are linked from ../../AWB/WikiFunctions,
       so the original Windows tree is untouched. Files here (Shims/) replace Windows-only pieces. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WikiFunctions</RootNamespace>
    <AssemblyName>WikiFunctions</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591;SYSLIB0014;SYSLIB0011;SYSLIB0021;SYSLIB0023;CA1416</NoWarn>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <SrcRoot>../../AWB/WikiFunctions/</SrcRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SemanticVersion" Version="2.1.0" />
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <WinSource Include="$(SrcRoot)API/ApiEdit.cs" Link="API/ApiEdit.cs" />
