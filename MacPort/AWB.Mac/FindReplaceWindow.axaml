<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoWikiBrowser.Mac.FindReplaceWindow"
        Title="Find and replace"
        Width="1000" Height="520" MinWidth="700" MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="80" />
        <Button x:Name="OkButton" Content="Done" IsDefault="True" MinWidth="80" Classes="accent" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="IgnoreLinksCheck" Content="Ignore external/interwiki links, images, nowiki, math and &lt;!-- --&gt;" />
        <CheckBox x:Name="IgnoreMoreCheck" Content="Also ignore templates, refs, link targets and headings" />
        <CheckBox x:Name="AddToSummaryCheck" Content="Add replacements to edit summary" />
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="AddButton" Content="Add rule" />
      <Button x:Name="DeleteButton" Content="Delete selected" />
      <Button x:Name="UpButton" Content="Move up" />
      <Button x:Name="DownButton" Content="Move down" />
      <Button x:Name="ClearButton" Content="Clear all" />
      <TextBlock VerticalAlignment="Center" Opacity="0.7"
                 Text="Use \n for a newline. With Regex on, $1 etc. refer to groups; %%title%% and other AWB keywords work too." />
    </StackPanel>
    <DataGrid x:Name="Grid" CanUserReorderColumns="False" CanUserSortColumns="False"
              GridLinesVisibility="All" BorderThickness="1" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Find" Binding="{Binding Find}" Width="2*" />
        <DataGridTextColumn Header="Replace with" Binding="{Binding Replace}" Width="2*" />
        <DataGridCheckBoxColumn Header="Case sensitive" Binding="{Binding CaseSensitive}" Width="Auto" />
        <DataGridCheckBoxColumn Header="Regex" Binding="{Binding IsRegex}" Width="Auto" />
        <DataGridCheckBoxColumn Header="Multiline" Binding="{Binding Multiline}" Width="Auto" />
        <DataGridCheckBoxColumn Header="Singleline" Binding="{Binding Singleline}" Width="Auto" />
        <DataGridCheckBoxColumn Header="Minor" Binding="{Binding Minor}" Width="Auto" />
        <DataGridCheckBoxColumn Header="After fixes" Binding="{Binding AfterFixes}" Width="Auto" />
        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
